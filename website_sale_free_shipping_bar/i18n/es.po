#. module: website_sale_free_shipping_bar
#. odoo-python
#: code:addons/website_sale_free_shipping_bar/models/sale_order.py:0
msgid "Add %(amount)s more for free delivery"
msgstr "Añada %(amount)s más para la entrega gratuita"

#. module: website_sale_free_shipping_bar
#: model:ir.model.fields,field_description:website_sale_free_shipping_bar.field_website__fsb_amount_basis
msgid "Amount Compared"
msgstr "Importe comparado"

#. module: website_sale_free_shipping_bar
#: model:ir.model.fields,help:website_sale_free_shipping_bar.field_website__fsb_free_shipping_threshold
msgid "Amount, in the website currency, at which delivery becomes free. Zero turns the bar off, exactly like the switch above."
msgstr "Importe, en la moneda del sitio web, a partir del cual la entrega es gratuita. Cero desactiva la barra, igual que el interruptor de arriba."

#. module: website_sale_free_shipping_bar
#: model_terms:ir.ui.view,arch_db:website_sale_free_shipping_bar.view_website_form_free_shipping
msgid "Free Delivery"
msgstr "Entrega gratuita"

#. module: website_sale_free_shipping_bar
#: model:ir.model.fields,field_description:website_sale_free_shipping_bar.field_website__fsb_free_shipping_enabled
msgid "Free Delivery Bar"
msgstr "Barra de entrega gratuita"

#. module: website_sale_free_shipping_bar
#: model:ir.module.module,shortdesc:base.module_website_sale_free_shipping_bar
msgid "Free Delivery Progress Bar"
msgstr "Barra de progreso hacia la entrega gratuita"

#. module: website_sale_free_shipping_bar
#: model:ir.model.fields,field_description:website_sale_free_shipping_bar.field_website__fsb_free_shipping_threshold
msgid "Free Delivery Threshold"
msgstr "Umbral de entrega gratuita"

#. module: website_sale_free_shipping_bar
#: model:ir.model.fields.selection,name:website_sale_free_shipping_bar.selection__website__fsb_amount_basis__untaxed
msgid "Goods, tax excluded"
msgstr "Mercancías, impuestos excluidos"

#. module: website_sale_free_shipping_bar
#: model:ir.model.fields.selection,name:website_sale_free_shipping_bar.selection__website__fsb_amount_basis__total
msgid "Goods, tax included"
msgstr "Mercancías, impuestos incluidos"

#. module: website_sale_free_shipping_bar
#: model:ir.model,name:website_sale_free_shipping_bar.model_sale_order
msgid "Sales Order"
msgstr "Pedido de venta"

#. module: website_sale_free_shipping_bar
#: model:ir.model.fields,help:website_sale_free_shipping_bar.field_website__fsb_free_shipping_enabled
msgid "Show the progress bar towards free delivery in the cart and at checkout. Off by default: a shop that says nothing about free delivery must not start promising one."
msgstr "Muestra la barra de progreso hacia la entrega gratuita en el carrito y en el pago. Desactivada por defecto: una tienda que no dice nada sobre la entrega gratuita no debe empezar a prometerla."

#. module: website_sale_free_shipping_bar
#: model:ir.module.module,summary:base.module_website_sale_free_shipping_bar
msgid "Tell the shopper how much is left before delivery is free: a progress bar in the cart and at checkout, fed by the goods in the cart only."
msgstr "Dile al comprador cuánto falta para la entrega gratuita: una barra de progreso en el carrito y en el pago, alimentada solo por las mercancías del carrito."

#. module: website_sale_free_shipping_bar
#: model_terms:ir.ui.view,arch_db:website_sale_free_shipping_bar.view_website_form_free_shipping
msgid ""
"The bar counts the goods in the cart, never the delivery\n"
"                        line. Leave the threshold at zero, or switch the bar\n"
"                        off, to say nothing about free delivery on this site."
msgstr "La barra cuenta las mercancías del carrito, nunca la línea de entrega. Deje el umbral a cero, o desactive la barra, para no decir nada sobre la entrega gratuita en este sitio."

#. module: website_sale_free_shipping_bar
#: model:ir.model,name:website_sale_free_shipping_bar.model_website
msgid "Website"
msgstr "Sitio web"

#. module: website_sale_free_shipping_bar
#: model:ir.model.fields,help:website_sale_free_shipping_bar.field_website__fsb_amount_basis
msgid "Which goods total the threshold is compared with. Delivery is never part of it: the bar measures what the customer is buying, not what the carrier charges."
msgstr "Con qué total de mercancías se compara el umbral. La entrega nunca forma parte de él: la barra mide lo que compra el cliente, no lo que cobra el transportista."

#. module: website_sale_free_shipping_bar
#. odoo-python
#: code:addons/website_sale_free_shipping_bar/models/sale_order.py:0
msgid "You have free delivery"
msgstr "Ya tiene la entrega gratuita"

#. module: website_sale_free_shipping_bar
#: model_terms:ir.ui.view,arch_db:website_sale_free_shipping_bar.view_website_form_free_shipping
msgid "e.g. 50.00"
msgstr "p. ej. 50,00"
