#. module: bs_free_shipping_bar
#. odoo-python
#: code:addons/bs_free_shipping_bar/models/sale_order.py:0
msgid "Add %(amount)s more for free delivery"
msgstr "Ajoutez encore %(amount)s pour la livraison gratuite"

#. module: bs_free_shipping_bar
#: model:ir.model.fields,field_description:bs_free_shipping_bar.field_website__fsb_amount_basis
msgid "Amount Compared"
msgstr "Montant comparé"

#. module: bs_free_shipping_bar
#: model:ir.model.fields,help:bs_free_shipping_bar.field_website__fsb_free_shipping_threshold
msgid "Amount, in the website currency, at which delivery becomes free. Zero turns the bar off, exactly like the switch above."
msgstr "Montant, dans la devise du site web, à partir duquel la livraison devient gratuite. Zéro désactive la barre, exactement comme l'interrupteur ci-dessus."

#. module: bs_free_shipping_bar
#: model_terms:ir.ui.view,arch_db:bs_free_shipping_bar.view_website_form_free_shipping
msgid "Free Delivery"
msgstr "Livraison gratuite"

#. module: bs_free_shipping_bar
#: model:ir.model.fields,field_description:bs_free_shipping_bar.field_website__fsb_free_shipping_enabled
msgid "Free Delivery Bar"
msgstr "Barre de livraison gratuite"

#. module: bs_free_shipping_bar
#: model:ir.module.module,shortdesc:base.module_bs_free_shipping_bar
msgid "Free Delivery Progress Bar"
msgstr "Barre de progression vers la livraison gratuite"

#. module: bs_free_shipping_bar
#: model:ir.model.fields,field_description:bs_free_shipping_bar.field_website__fsb_free_shipping_threshold
msgid "Free Delivery Threshold"
msgstr "Seuil de livraison gratuite"

#. module: bs_free_shipping_bar
#: model:ir.model.fields.selection,name:bs_free_shipping_bar.selection__website__fsb_amount_basis__untaxed
msgid "Goods, tax excluded"
msgstr "Marchandises, hors taxes"

#. module: bs_free_shipping_bar
#: model:ir.model.fields.selection,name:bs_free_shipping_bar.selection__website__fsb_amount_basis__total
msgid "Goods, tax included"
msgstr "Marchandises, taxes comprises"

#. module: bs_free_shipping_bar
#: model:ir.model,name:bs_free_shipping_bar.model_sale_order
msgid "Sales Order"
msgstr "Commande client"

#. module: bs_free_shipping_bar
#: model:ir.model.fields,help:bs_free_shipping_bar.field_website__fsb_free_shipping_enabled
msgid "Show the progress bar towards free delivery in the cart and at checkout. Off by default: a shop that says nothing about free delivery must not start promising one."
msgstr "Affiche la barre de progression vers la livraison gratuite dans le panier et au paiement. Désactivée par défaut : une boutique qui ne dit rien de la livraison gratuite ne doit pas se mettre à la promettre."

#. module: bs_free_shipping_bar
#: model:ir.module.module,summary:base.module_bs_free_shipping_bar
msgid "Tell the shopper how much is left before delivery is free: a progress bar in the cart and at checkout, fed by the goods in the cart only."
msgstr "Indique à l'acheteur ce qu'il reste avant la livraison gratuite : une barre de progression dans le panier et au paiement, alimentée uniquement par les marchandises du panier."

#. module: bs_free_shipping_bar
#: model_terms:ir.ui.view,arch_db:bs_free_shipping_bar.view_website_form_free_shipping
msgid ""
"The bar counts the goods in the cart, never the delivery\n"
"                        line. Leave the threshold at zero, or switch the bar\n"
"                        off, to say nothing about free delivery on this site."
msgstr "La barre compte les marchandises du panier, jamais la ligne de livraison. Laissez le seuil à zéro, ou désactivez la barre, pour ne rien dire de la livraison gratuite sur ce site."

#. module: bs_free_shipping_bar
#: model:ir.model,name:bs_free_shipping_bar.model_website
msgid "Website"
msgstr "Site Web"

#. module: bs_free_shipping_bar
#: model:ir.model.fields,help:bs_free_shipping_bar.field_website__fsb_amount_basis
msgid "Which goods total the threshold is compared with. Delivery is never part of it: the bar measures what the customer is buying, not what the carrier charges."
msgstr "À quel total de marchandises le seuil est comparé. La livraison n'en fait jamais partie : la barre mesure ce que le client achète, pas ce que le transporteur facture."

#. module: bs_free_shipping_bar
#. odoo-python
#: code:addons/bs_free_shipping_bar/models/sale_order.py:0
msgid "You have free delivery"
msgstr "Vous bénéficiez de la livraison gratuite"

#. module: bs_free_shipping_bar
#: model_terms:ir.ui.view,arch_db:bs_free_shipping_bar.view_website_form_free_shipping
msgid "e.g. 50.00"
msgstr "ex. 50,00"
