<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- The threshold is per website: two shops on one database may ship on
         different terms, and the switch is the merchant's, not the theme's.
         The anchor is the notebook itself: 16.0's only page there is the
         "Custom Code" one without a `name`, so anchoring on a named page would
         both break 16.0 and hide this page from merchants. -->
    <record id="view_website_form_free_shipping" model="ir.ui.view">
        <field name="name">website.form.free.shipping</field>
        <field name="model">website</field>
        <field name="inherit_id" ref="website.view_website_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Free Delivery" name="page_free_shipping">
                    <group>
                        <field name="fsb_free_shipping_enabled"/>
                        <field name="fsb_free_shipping_threshold"
                               placeholder="e.g. 50.00"/>
                        <field name="fsb_amount_basis"/>
                    </group>
                    <div class="text-muted mt-2">
                        The bar counts the goods in the cart, never the delivery
                        line. Leave the threshold at zero, or switch the bar
                        off, to say nothing about free delivery on this site.
                    </div>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
